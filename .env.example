# Porta de execução do servidor backend
PORT=5000

# String de conexão com o MongoDB (Atlas em produção ou MongoDB local)
# Exemplo MongoDB Atlas: mongodb+srv://<usuario>:<senha>@seu-cluster.mongodb.net/game_cards?retryWrites=true&w=majority
# Exemplo MongoDB Local: mongodb://localhost:27017/game_cards
MONGODB_URI=mongodb+srv://usuario_exemplo:senha_exemplo@cluster0.mongodb.net/game_cards?retryWrites=true&w=majority

# Origens permitidas para CORS (use '*' para todas ou especifique o domínio do frontend como https://meu-frontend.vercel.app)
CORS_ORIGIN=*

# Ambiente de execução ('development' ou 'production')
NODE_ENV=development
